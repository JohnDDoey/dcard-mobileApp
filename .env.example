# Copier vers `.env.local` (Next.js) ou `.env`. Ne pas commiter les vrais fichiers `.env`.

# RPC du réseau cible : local Hardhat → http://127.0.0.1:8545
# ZKsync Sepolia → https://sepolia.era.zksync.dev | Mainnet → https://mainnet.era.zksync.io
RPC_URL=http://127.0.0.1:8545
NEXT_PUBLIC_RPC_URL=http://127.0.0.1:8545

# Clé utilisée par les routes API qui signent (burn-coupon, burn-ticket, record-*).
# Jamais NEXT_PUBLIC_* — reste côté serveur uniquement.
COMPANY_WALLET_PRIVATE_KEY=

# URL publique du site (paiements Flutterwave callback, logos, etc.)
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Optionnel si tu utilises src/contracts/abi/config.ts avec override env
NEXT_PUBLIC_CASHBACK_REGISTRY_ADDRESS=
